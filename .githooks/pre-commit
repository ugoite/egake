#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

echo "pre-commit: checking formatting"
mise run fmt:check

echo "pre-commit: checking Tailwind runtime CSS"
mise run ui:check

echo "pre-commit: checking Rust types"
mise run rust:check

echo "pre-commit: checking Deno lint and types"
mise run deno:lint
mise run deno:check

echo "pre-commit: checking Python lint and types"
mise run python:lint
mise run python:typecheck

echo "pre-commit: checking documentation and locale pairs"
mise run docs:check

echo "pre-commit: checking product brand"
mise run brand:check
