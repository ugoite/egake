# Rust/Cargo build output
/target/
*.rs.bk

# Node package managers and generated TypeScript output
node_modules/
.npm/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Deno local metadata; deno.lock remains trackable below.
.deno/

# Astro/Starlight and other generated application output
/dist/
/docsite/dist/
/docsite/.astro/
/coverage/
*.profraw

# Python tooling, environments, and generated files
.python-version
.venv/
.ruff_cache/
.ty/
.pytest_cache/
.mypy_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
pip-wheel-metadata/
.coverage
htmlcov/

# Local tooling and environment files
/.mise/
/.direnv/
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
.vscode/
*.iml
.DS_Store
._*
.AppleDouble
.LSOverride
*.swp
*.swo
*~

# Source, Markdown, and dependency lockfiles are intentionally trackable.
!**/*.rs
!**/*.ts
!**/*.tsx
!**/*.js
!**/*.jsx
!**/*.py
!**/*.md
!**/Cargo.lock
!**/deno.lock
!**/package-lock.json
